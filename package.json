{
  "name": "luxe-latte",
  "version": "1.0.0",
  "description": "Luxe Latte coffee & juice joint: website with online ordering, M-Pesa Paybill payments and an order dashboard.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
