# Copy to .env (or set these in your hosting dashboard).

# Password for the order dashboard at /admin. Required in production.
ADMIN_PASSWORD=change-me-to-something-long

# Random string used to sign dashboard sessions. Keep it secret; changing it signs everyone out.
SESSION_SECRET=paste-a-long-random-string-here

# Port to listen on (most hosts set this for you).
PORT=3000

# Where the SQLite database is stored. Point this at a persistent disk/volume in production.
STORAGE_DIR=./storage

# Set to 1 when running behind a reverse proxy / load balancer (Render, Railway, Nginx, Cloudflare).
TRUST_PROXY=

# Minutes from UTC used for "today" stats on the dashboard (Nairobi = 180).
TZ_OFFSET_MINUTES=180

# ---- M-Pesa prompts (STK Push) via Safaricom Daraja: leave blank to turn off ----
# Get these from https://developer.safaricom.co.ke after your shortcode is approved for Lipa na M-Pesa Online.
MPESA_ENV=sandbox            # sandbox while testing, production when live
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=             # your Paybill number (or Till head-office/store number)
MPESA_PASSKEY=               # Lipa na M-Pesa Online passkey from Safaricom
MPESA_TYPE=paybill           # paybill or till
MPESA_TILL_NUMBER=           # only for MPESA_TYPE=till
# Public https address of this site; Safaricom sends payment results to PUBLIC_URL/api/mpesa/callback/...
PUBLIC_URL=https://luxe-latte.onrender.com
